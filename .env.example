# Copy to .env and fill in what you need. Everything is optional.

# --- LLM (pick one; leave empty to use extractive answers) ---
# Free options: GROQ_API_KEY from https://console.groq.com, or install Ollama and run "ollama pull llama3.2"
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local model used when LLM_PROVIDER=hf (needs requirements-full.txt)
HF_LLM_MODEL=google/flan-t5-base

# --- Models ---
DL_BACKEND=auto
BERT_MODEL=distilbert-base-uncased
EMBEDDER=auto
CONFIDENCE_THRESHOLD=0.55

# --- Storage: path to a Firebase service-account JSON (else SQLite) ---
FIREBASE_CREDENTIALS=

# --- Web app ---
SECRET_KEY=change-me

# --- RAG and LLM evaluation on the attitude dataset ---
CV_FOLDS=5
RAG_K=7

# --- Optional channels ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_NOTIFY_TO=
